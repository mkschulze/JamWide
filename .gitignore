# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# EXCEPTION: vendored LGPL ffmpeg dylibs (260515-0pc spike + milestone Item B)
# These are required for the JAMWIDE_VIDEO_SPIKE option and the future video
# milestone (RESEARCH §3 distribution-strategy decision). Do not blanket-ignore.
!libs/ffmpeg/**/*.dylib
!libs/ffmpeg/**/*.so
!libs/ffmpeg/**/*.dll
# .lib exception lives further down — after the `*.lib` general exclude
# at line ~41 (otherwise the later general rule overrides this one).

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib
# EXCEPTION: vendored Windows ffmpeg MSVC import libraries — generated by
# scripts/build_ffmpeg_lgpl.sh post-process and bundled at libs/ffmpeg/
# windows-x86_64/lib/. Must come AFTER the *.lib rule above to override it.
!libs/ffmpeg/**/*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo

# Build revision counter (auto-incremented, local only)
.build_revision

# Build outputs
build/
build-release/
build-juce/
build-spike/
build-test/
build-tsan/
.bg-shell/
logs/
.cache/
*.DS_Store
*.log

# Signing credentials (never commit)
*.p8
*.p12
notarize.env
companion/node_modules/
companion/dist/
.claude/settings.local.json
